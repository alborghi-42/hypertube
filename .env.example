# Copy to .env and fill in. NEVER commit .env (see .gitignore) — the 42
# subject fails the project automatically if credentials land in git.

# Postgres (docker-compose substitutes these into the postgres service and
# the backend's DATABASE_URL). Pick your own password; required by compose.
POSTGRES_DB=hypertube
POSTGRES_USER=hypertube
POSTGRES_PASSWORD=change-me

# Backend
# DSN used when the backend (or `make migrate-up`) runs on the host; inside
# docker-compose it is overridden with the postgres service host. Keep the
# credentials in sync with POSTGRES_* above. Empty = no DB (media/auth routes off).
DATABASE_URL=postgres://hypertube:change-me@localhost:5432/hypertube?sslmode=disable
PORT=8080
# Root for downloads, conversions and avatars (a PVC in production).
DATA_DIR=/data
# Public path prefix when served below a sub-path (e.g. /hypertube); empty = /.
# Must match the image's BASE_HREF build arg.
BASE_PATH=
# Angular SSR server the backend reverse-proxies non-API traffic to, and the
# command to spawn it (set in the production image; leave empty in dev).
SSR_UPSTREAM=http://127.0.0.1:4000
SSR_COMMAND=
# Port the SSR node server listens on (frontend/src/server.ts).
SSR_PORT=4000
# Secure flag on the session/CSRF cookies (default true). false only for
# local development over plain http; never in production.
COOKIE_SECURE=false
# Proxies whose X-Forwarded-For is trusted for the client IP (comma-separated
# IPs/CIDRs). Empty = trust nobody (direct connections; per-IP rate limits use
# the TCP peer). Production sits behind Traefik + cloudflared in k3s: set the
# cluster pod CIDR, e.g. TRUSTED_PROXIES=10.42.0.0/16. Never 0.0.0.0/0.
TRUSTED_PROXIES=

# OAuth login strategies (M1)
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional extra OpenID Connect provider, configured from env only (endpoints
# from OIDC_ISSUER/.well-known/openid-configuration at startup). The name is
# the URL segment (callback /api/auth/<name>/callback); it needs a frontend button.
OIDC_PROVIDER_NAME=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# External origin the browser uses (no path; BASE_PATH is appended). Callback
# URLs to register at the providers: PUBLIC_URL + BASE_PATH +
# /api/auth/42/callback, /api/auth/github/callback and
# /api/auth/google/callback; reset links use
# PUBLIC_URL + BASE_PATH + /reset-password. A provider is disabled
# while its client id/secret are empty.
PUBLIC_URL=http://localhost:4200

# External APIs
# Optional: enriches media with IMDb rating/actors; leave empty to skip.
OMDB_API_KEY=
# Subtitles (OpenSubtitles REST API, https://www.opensubtitles.com/consumers).
# Empty API key = no subtitles. The user agent must match the consumer's
# registered app name ("<App> v<version>"). Username/password of an
# opensubtitles.com account are needed by the download endpoint.
OPENSUBTITLES_API_KEY=
OPENSUBTITLES_USER_AGENT=Hypertube v1.0
OPENSUBTITLES_USERNAME=
OPENSUBTITLES_PASSWORD=

# Password-reset email (M1). Dev defaults point at the Mailpit service in
# docker-compose (web UI: http://localhost:8025). Leave SMTP_HOST empty to
# log the reset link instead of sending it. Port 465 = implicit TLS,
# otherwise STARTTLS when the server offers it.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hypertube@bombatomica64.dev

# BitTorrent download engine (media). Data lives in DATA_DIR/downloads.
# Peer port (TCP+UDP) - expose it for incoming peers; 0 = random.
TORRENT_LISTEN_PORT=6881
TORRENT_NO_UPLOAD=false
TORRENT_SEED=false
# Fail a download that makes no progress for this long (Go duration; 0 = never).
TORRENT_STALL_TIMEOUT=10m
# Delete downloads nobody watched for this long (Go duration; 0 = never).
# Checked hourly.
MEDIA_RETENTION=720h

# ffmpeg conversion of non-browser formats (mkv/avi...) to fragmented MP4.
# Binaries default to the ones on PATH.
FFMPEG_PATH=
FFPROBE_PATH=
# Max concurrent on-the-fly conversions (default 2).
MAX_TRANSCODES=2
# Encoder threads per downscaled (720p/480p/360p) stream; 0 = ffmpeg default (all cores).
SCALE_THREADS=4

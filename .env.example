# Copy to .env and fill in. NEVER commit .env (see .gitignore) — the 42
# subject fails the project automatically if credentials land in git.

# Backend
DATABASE_URL=postgres://hypertube:hypertube@localhost:5432/hypertube?sslmode=disable
PORT=8080
DATA_DIR=/data
JWT_SECRET=change-me

# OAuth login strategies (M1)
FORTYTWO_CLIENT_ID=
FORTYTWO_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE_URL=http://localhost:4200

# External APIs (M2/M4)
TMDB_API_KEY=
OPENSUBTITLES_API_KEY=

# Password-reset email (M1)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=hypertube@bombatomica64.dev
